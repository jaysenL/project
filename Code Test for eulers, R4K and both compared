)

ax1.set_title("SIR Population Trajectories")

ax1.set_xlabel("Time")

ax1.set_ylabel("Population")

ax1.grid(alpha=0.3)

ax1.legend()


# =========================================================
# HEATMAP
# =========================================================

# logarithmic scaling
log_heat = np.log1p(heat)

im = ax2.imshow(
    log_heat,
    origin="lower",
    cmap="inferno",
    interpolation="gaussian",
    aspect="auto"
)

ax2.set_title("Monte Carlo Style SIR Heatmap")

ax2.set_xlabel("Time Step")

ax2.set_ylabel("Population Group")


# y-axis labels
ax2.set_yticks([0, 1, 2])

ax2.set_yticklabels([
